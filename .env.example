# ─── apty environment ────────────────────────────────────────────────────────
# Copy to .env.local for local dev (or .env for Docker) and fill in.

# Dev-only identity. In production, Cloudflare Access provides the email and
# this is ignored.
DEV_USER_EMAIL=you@example.com

# libsql / SQLite database file (created automatically).
DATABASE_URL=file:./data/apty.db

# Web Push (VAPID). Generate a keypair with:  npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cloudflare Access hardening (optional). Set these to verify the Access JWT
# instead of trusting the email header blindly.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# Cloudflare Tunnel token (from the dashboard-managed tunnel). Used by the
# cloudflared service in docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# Chore reminder cron window (minutes) — must match how often you run
# `npm run reminders`.
REMINDER_WINDOW_MIN=15
